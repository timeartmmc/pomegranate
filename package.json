{
  "name": "@pomegranate/compiler",
  "version": "0.1.0",
  "description": "A strict local OpenAPI compiler for TypeScript request contracts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timeartmmc/pomegranate.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "pom": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings --type-aware --type-check src examples/json && oxlint --deny-warnings scripts test",
    "test": "node --test test/*.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "example:generate": "node dist/cli.js generate --config examples/json/pom.json",
    "example:check": "node dist/cli.js check --config examples/json/pom.json",
    "example:run": "tsc -p examples/json/tsconfig.json && node examples/json/.build/demo.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "npm run format:check && npm run lint && npm run build && npm test && npm run example:check && npm run example:run && npm run test:package",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "ajv": "8.20.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "oxfmt": "0.74.0"
  }
}
