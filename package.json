{
  "name": "pomegranate-compiler",
  "version": "0.2.0",
  "license": "MIT",
  "description": "A strict local OpenAPI compiler for TypeScript request contracts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timeartmmc/pomegranate.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "bun@1.4.3",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "bin": {
    "pom": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "QUERIES.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.json && node scripts/copy-runtime.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "oxlint --deny-warnings --type-aware --type-check src examples/json test scripts",
    "test:prepare": "node scripts/prepare-tests.ts",
    "test": "node --test --test-timeout=30000 test/*.test.ts",
    "test:package": "node scripts/verify-package.ts",
    "example:generate": "node dist/cli.js generate --config examples/json/pom.json",
    "example:check": "node dist/cli.js check --config examples/json/pom.json",
    "example:run": "tsc -p examples/json/tsconfig.json && node examples/json/.build/demo.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify": "bun run format:check && bun run build && bun run test:prepare && bun run typecheck && bun run lint && bun run test && bun run example:check && bun run example:run && bun run test:package",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.104.5",
    "zod": "^4.6.6"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/query-core": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@types/node": "26.6.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "oxfmt": "0.73.0",
    "yaml": "2.9.1"
  }
}
